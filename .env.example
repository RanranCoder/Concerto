# 复制为 .env 并填写真实值。.env 已被 .gitignore 忽略，不会提交到仓库。
# 服务器上部署时用 `openssl rand -hex 32` 生成随机密码/密钥。
# PAMS_WEB_PORT=3000 # 可选：覆盖 Compose 的前端端口（deploy.sh 默认 8080）

# MySQL root 密码
MYSQL_ROOT_PASSWORD=change_me_root_password
# 应用连接 MySQL 的账号
MYSQL_USER=pams
MYSQL_PASSWORD=change_me_app_password
# PostgreSQL (docker-compose.postgresql.yml 或 Windows 的 PAMS_DB_ENGINE=postgresql)
# PAMS_PG_ADMIN_PASSWORD=
# PAMS_PG_DATABASE=pams_db
# PAMS_PG_URL=jdbc:postgresql://postgresql:5432/pams_db
# PAMS_PG_USER=pams_candidate
# PAMS_PG_PASSWORD=
# PAMS_PG_PROFILE=postgresql-candidate
# PAMS_DB_ENGINE=postgresql

# JWT 签名密钥（随机 64 字符以上长字符串）
PAMS_JWT_SECRET=
# 使用仓库的 HTTPS 宿主机 Nginx 入口时启用下面两项。
# PAMS_COOKIE_SECURE=true
# PAMS_TRUST_PROXY_HEADERS=true

# Concerto 部署默认服务（也可在系统设置中添加组织级配置）
PAMS_AGENT_PROTOCOL=openai_responses
PAMS_AGENT_TIMEOUT_MS=120000
PAMS_AGENT_BASE_URL=https://api.openai.com/v1
PAMS_AGENT_MODEL=
PAMS_AGENT_API_KEY=
# Responses 可选推理摘要；仅支持此能力的模型启用
PAMS_AGENT_SUMMARY_ENABLED=false
# 可不填写：系统自动生成并持久化加密密钥。已有显式密钥保持原值，勿直接替换。
PAMS_AI_ENCRYPTION_KEY=
# 明确允许访问的内网模型主机名，逗号分隔；默认不允许
PAMS_AI_INTERNAL_HOSTS=
